EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# API root (no trailing slash). For local dev, `localhost` is rewritten on device/emulator — see src/api/config.ts
EXPO_PUBLIC_BASE_URL=http://localhost:3000/api/v1
# Optional: force LAN IP when auto-detection fails (physical device / strict network)
# EXPO_PUBLIC_DEV_LAN_HOST=192.168.1.42
# Optional: full health URL if not at {EXPO_PUBLIC_BASE_URL}/health
# EXPO_PUBLIC_HEALTH_URL=http://localhost:3000/health